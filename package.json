{
  "name": "smooth-stream-text",
  "version": "0.2.1",
  "description": "Adaptive client-side pacing for streamed LLM text. Keep your Markdown renderer; the answer appears at an even rate. Zero-dependency headless core with React, Vue, Svelte and Web Component bindings and an optional fade-in reveal.",
  "author": "Maksim Zolotoi",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crmapache/smooth-stream-text.git"
  },
  "bugs": {
    "url": "https://github.com/crmapache/smooth-stream-text/issues"
  },
  "homepage": "https://smooth-stream-text.vercel.app/docs/",
  "keywords": [
    "streaming-text",
    "smooth-streaming",
    "stream-text",
    "llm",
    "llm-ui",
    "ai-chat-ui",
    "ai-ui",
    "typewriter",
    "text-reveal",
    "streaming-markdown",
    "token-streaming",
    "headless",
    "react",
    "vue",
    "svelte",
    "web-component",
    "animation",
    "ai-sdk",
    "vercel-ai-sdk",
    "react-hooks",
    "nextjs",
    "nuxt",
    "sveltekit",
    "streamdown",
    "react-markdown",
    "chat-ui",
    "streaming",
    "sse"
  ],
  "sideEffects": [
    "**/web-component/**",
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dom": [
        "./dist/dom/index.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ],
      "vue": [
        "./dist/vue/index.d.ts"
      ],
      "svelte": [
        "./dist/svelte/index.d.ts"
      ],
      "web-component": [
        "./dist/web-component/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/dom/index.d.ts",
        "default": "./dist/dom/index.js"
      },
      "require": {
        "types": "./dist/dom/index.d.cts",
        "default": "./dist/dom/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      },
      "require": {
        "types": "./dist/vue/index.d.cts",
        "default": "./dist/vue/index.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte/index.d.ts",
        "default": "./dist/svelte/index.js"
      },
      "require": {
        "types": "./dist/svelte/index.d.cts",
        "default": "./dist/svelte/index.cjs"
      }
    },
    "./web-component": {
      "import": {
        "types": "./dist/web-component/index.d.ts",
        "default": "./dist/web-component/index.js"
      },
      "require": {
        "types": "./dist/web-component/index.d.cts",
        "default": "./dist/web-component/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "build:playground": "vite build",
    "preview": "vite preview",
    "dev:docs": "vitepress dev website --port 5194 --strictPort",
    "preview:docs": "vitepress preview website --port 5195",
    "build:site": "node scripts/build-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm test && npm run check:package && npm run check:docs",
    "check:package": "publint && attw --pack . --exclude-entrypoints styles.css",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
